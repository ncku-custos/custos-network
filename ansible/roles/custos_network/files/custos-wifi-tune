#!/usr/bin/env bash
# custos-wifi-tune <iface>
#
# Installed to /usr/local/sbin and run at boot by custos-wifi-tune@<iface>.service,
# ordered BEFORE hostapd / wpa_supplicant. Does the two things systemd-networkd cannot:
#   1. set the regulatory domain (required for ch149 to be permitted)
#   2. disable Wi-Fi power-save (PS-on adds ~100 ms jitter — unacceptable for a flight link)
#
# Self-contained on purpose: it runs from /usr/local/sbin and must not depend on the repo.
set -euo pipefail

IFACE="${1:?usage: custos-wifi-tune <iface>}"

# Country comes from the facts file the role writes; fallback = the role default.
# shellcheck disable=SC1091
[ -r /etc/custos-network.env ] && . /etc/custos-network.env
COUNTRY="${CUSTOS_COUNTRY:-TW}"

# A soft-blocked radio makes everything silently fail — clear it first. Scoped to
# the flight NIC's phy: `rfkill unblock wlan` is type-wide and would undo a
# deliberate soft-block of another radio on a multi-radio ground laptop.
# Best-effort: vendor kernels built without CONFIG_RFKILL have no /dev/rfkill, and
# nothing can be blocked there anyway.
if command -v rfkill >/dev/null 2>&1 && [ -e /dev/rfkill ]; then
  phy="phy$(iw dev "$IFACE" info | awk '/wiphy/{print $2; exit}')" || true
  idx="$(rfkill list | awk -F: -v p="$phy" '$2 == " " p {print $1; exit}')" || true
  rfkill unblock "${idx:-wlan}" || true
fi

# The regulatory domain is machine-global (all radios, uplink included) — only set
# it when it actually differs, so boots/re-runs don't kick other radios' links.
#
# `iw reg set` is fire-and-forget: the kernel queues the request and applies it
# asynchronously (it may still be waiting on the regulatory.db firmware load this
# early in boot). Our only reason to exist is the Before=hostapd ordering, so poll
# until the domain is actually applied — otherwise hostapd starts against world
# domain 00, where ch149 is no-IR, fails "Could not set channel", and exits 0
# (observed on the nt98690 drone board, t≈10s after boot).
current="$(iw reg get 2>/dev/null | awk '/^country/{print substr($2,1,2); exit}')" || true
if [ "$current" != "$COUNTRY" ]; then
  iw reg set "$COUNTRY"
  for _ in $(seq 1 50); do
    current="$(iw reg get 2>/dev/null | awk '/^country/{print substr($2,1,2); exit}')" || true
    [ "$current" = "$COUNTRY" ] && break
    sleep 0.2
  done
  if [ "$current" != "$COUNTRY" ]; then
    echo "custos-wifi-tune: reg domain still '$current' after 10s (wanted $COUNTRY)" >&2
    exit 1
  fi
fi
iw dev "$IFACE" set power_save off

# Fail loud if power-save did not actually go off.
ps_state="$(iw dev "$IFACE" get power_save 2>/dev/null | awk '{print $NF}')"
if [ "$ps_state" != "off" ]; then
  echo "custos-wifi-tune: power_save still '$ps_state' on $IFACE" >&2
  exit 1
fi

echo "custos-wifi-tune: $IFACE reg=$COUNTRY power_save=off"

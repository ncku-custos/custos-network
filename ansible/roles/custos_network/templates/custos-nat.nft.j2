# Custos ground NAT — masquerade the flight subnet out the uplink.
# Dedicated table, atomic declare-then-delete replace: idempotent on first load,
# and `nft -f` re-applies it in one transaction with no delete/reload window.
# Scoped by design — never touches other tables (ufw, Docker, iptables-nft).
table ip custos_nat
delete table ip custos_nat
table ip custos_nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr {{ custos_network_flight_subnet }} oifname "{{ custos_network_uplink_iface }}" masquerade
    }

    # policy accept + scoped rules: a drop policy here would kill OTHER forwarding on
    # this box (Docker bridges, libvirt) — nft requires acceptance in EVERY base chain.
    # These rules control only traffic touching the flight link.
    chain forward {
        type filter hook forward priority filter; policy accept;
{% if custos_network_clamp_mss | bool %}
        # Clamp TCP MSS to path MTU both ways (non-terminal — must precede the accepts).
        # Phone/cellular uplinks have small MTUs; a no-op on 1500-MTU ethernet.
        iifname "{{ custos_network_flight_iface }}" oifname "{{ custos_network_uplink_iface }}" tcp flags syn tcp option maxseg size set rt mtu
        iifname "{{ custos_network_uplink_iface }}" oifname "{{ custos_network_flight_iface }}" tcp flags syn tcp option maxseg size set rt mtu
{% endif %}
        iifname "{{ custos_network_flight_iface }}" oifname "{{ custos_network_uplink_iface }}" accept
        iifname "{{ custos_network_uplink_iface }}" oifname "{{ custos_network_flight_iface }}" ct state established,related accept
        iifname "{{ custos_network_uplink_iface }}" oifname "{{ custos_network_flight_iface }}" drop comment "no unsolicited ingress to the flight net"
        iifname "{{ custos_network_flight_iface }}" drop comment "flight net exits ONLY via the uplink"
        oifname "{{ custos_network_flight_iface }}" drop comment "nothing else forwards into the flight net"
    }
}

# Custos drone AP — the bare IP flight link.
# DEV PSK committed deliberately — ROTATE BEFORE ANY REAL DEPLOYMENT (see README).
interface={{ custos_network_flight_iface }}
driver=nl80211

# --- Identity ---
ssid={{ custos_network_ssid }}

# --- Regulatory (TW) ---
country_code={{ custos_network_country }}
ieee80211d=1          # advertise the country IE so the STA inherits TW regulatory
ieee80211h=0          # DFS/802.11h OFF — ch149 is non-DFS; enabling it would arm CAC

# --- Band / channel: 5 GHz, channel 149 (U-NII-3, non-DFS, outdoor-legal) ---
hw_mode=a
channel={{ custos_network_channel }}
ieee80211n=1
ht_capab=[HT40+][SHORT-GI-20][SHORT-GI-40]
{% if custos_network_vht | bool %}
ieee80211ac=1
vht_capab=[SHORT-GI-80]
vht_oper_chwidth=1                 # 80 MHz
vht_oper_centr_freq_seg0_idx={{ custos_network_vht_seg0 }}  # center index for the 149/153/157/161 VHT80 block
{% else %}
# VHT off (custos_network_vht) — HT40 only, ~270 Mbit/s PHY. See the README gotcha:
# some STA drivers (rtw88_8822bu) black-hole >900 B AP→STA frames under VHT80.
{% endif %}
# 802.11ax (WiFi6) / HE160 deliberately OFF — historically flaky on mt7921/mt7922
# AP mode. Enable only with a proven driver pairing.

# --- QoS substrate (kept default now; tuned in the QoS phase, not here) ---
wmm_enabled=1

# --- Security: WPA2-PSK ---
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase={{ custos_network_wifi_psk }}

# Custos ground STA — associates to the drone AP. DEV PSK — ROTATE BEFORE DEPLOYMENT.
ctrl_interface=/run/wpa_supplicant
update_config=0           # do NOT let the daemon rewrite this version-controlled file
country={{ custos_network_country }}

network={
    ssid="{{ custos_network_ssid }}"
    scan_ssid=1                       # actively probe (works even if the AP later hides its SSID)
    bssid={{ custos_network_ap_bssid }}           # PIN to the drone's real flight-iface MAC — TODO before bring-up
    key_mgmt=WPA-PSK
    psk="{{ custos_network_wifi_psk }}"         # must match hostapd wpa_passphrase
    bgscan=""                         # NO background scanning — avoids mid-flight off-channel jitter
    freq_list={{ custos_network_freq }}                    # pin to ch149 only
    scan_freq={{ custos_network_freq }}
    priority=10
}

CUSTOS_FLIGHT_IFACE={{ custos_network_flight_iface }}
CUSTOS_ROLE={{ custos_network_role }}
CUSTOS_DRONE_IP={{ custos_network_drone_ip }}
CUSTOS_GROUND_IP={{ custos_network_ground_ip }}
CUSTOS_FLIGHT_SUBNET={{ custos_network_flight_subnet }}
CUSTOS_COUNTRY={{ custos_network_country }}
CUSTOS_NAT={{ 'true' if custos_network_enable_nat | bool else 'false' }}

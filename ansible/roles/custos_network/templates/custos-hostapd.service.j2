[Unit]
Description=Custos hostapd AP on {{ custos_network_flight_iface }} (bare IP flight link)
# Tie lifecycle to the physical interface: start only once {{ custos_network_flight_iface }} exists, stop if it goes.
BindsTo=sys-subsystem-net-devices-{{ custos_network_flight_iface }}.device
After=sys-subsystem-net-devices-{{ custos_network_flight_iface }}.device
# Radio must be in TW + power-save off before the AP comes up.
Wants=custos-wifi-tune@{{ custos_network_flight_iface }}.service
After=custos-wifi-tune@{{ custos_network_flight_iface }}.service
# Paired with Restart=always below: never give up on bringing the AP back.
StartLimitIntervalSec=0

[Service]
Type=simple
# Deliberately type-wide (unlike custos-wifi-tune's phy-scoped unblock): this unit
# only runs on the drone AP, which has a single radio — robustness wins here.
# '-' prefix: rfkill is best-effort. Vendor kernels without CONFIG_RFKILL have no
# /dev/rfkill, so this exits 1 — and hostapd itself tolerates that (it warns and
# comes up). A real soft-block still surfaces as a loud hostapd failure.
ExecStartPre=-/usr/sbin/rfkill unblock wlan
ExecStart=/usr/sbin/hostapd /etc/hostapd/hostapd.conf
# Restart=always, not on-failure: hostapd exits 0 on "Interface initialization
# failed" (e.g. the channel is still no-IR because the reg domain hasn't been
# applied yet), so on-failure lets a headless drone stay AP-less until someone
# logs in. Retry forever — there is no operator in the field.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

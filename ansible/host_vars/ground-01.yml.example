---
# Copy to ground-01.yml (git-ignored) and fill in real values.
# host_vars outranks inventory.ini placeholders and group_vars — no -e / -i juggling needed.

# Management IP for provisioning — the ground's eth0/cellular uplink, NEVER 192.168.4.2.
ansible_host: 10.0.0.20

# The drone's real wlan0 MAC (read it on the drone: `ip link show wlan0`).
# Outranks the placeholder in group_vars/ground.yml.
custos_network_ap_bssid: "aa:bb:cc:dd:ee:ff"

# Uncomment if the ground's internet-side interface is not eth0 (e.g. wwan0):
# custos_network_uplink_iface: wwan0

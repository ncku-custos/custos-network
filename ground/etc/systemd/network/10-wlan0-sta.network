[Match]
Name=wlan0

[Network]
Address=192.168.4.2/24
LinkLocalAddressing=no
# STA carrier comes from wpa_supplicant association; allow config before/independent of it,
# and retain the static IP through deauth/disconnect so recovery is L2-only:
ConfigureWithoutCarrier=yes
IgnoreCarrierLoss=yes

[Link]
RequiredForOnline=no
